{
  "_comment": "Fragment to merge into config.json for Firecracker disposable workers. Replace parent token_sha256 values (python gateway.py hash-token <token>). Backend URL is your parent model's OpenAI-compatible endpoint.",
  "agents": {
    "fc_worker": {
      "_note": "run_scoped template: no static token. Each spawn_worker run registers a fresh token hash (run_agents) valid only for that run as fc_worker@<run_id>.",
      "run_scoped": true,
      "token_sha256": "",
      "trust_tier": "web_dmz",
      "allowed_client_cidrs": [
        "127.0.0.1/32"
      ],
      "allowed_capabilities": [
        "submit_artifact",
        "worker_llm",
        "worker_search",
        "worker_fetch",
        "worker_repo"
      ],
      "allowed_routes": [
        "fc.artifacts.submit",
        "fc.llm.chat",
        "fc.search",
        "fc.fetch",
        "fc.repo"
      ]
    },
    "parent_mcp": {
      "_note": "add to the existing parent agent",
      "allowed_capabilities": [
        "inspect",
        "register_run",
        "download_artifact"
      ],
      "allowed_routes": [
        "security.inspect_only",
        "security.runs.register",
        "security.artifacts.download"
      ]
    }
  },
  "routes": {
    "fc.artifacts.submit": {
      "kind": "inspect_only",
      "allowed_callers": [
        "fc_worker"
      ],
      "required_capability": "submit_artifact",
      "require_run_id": true,
      "description": "Disposable Firecracker worker result submission into ASG quarantine; run-scoped.",
      "input_policy": {
        "accepted_taint": [
          "untrusted_web",
          "sandbox_output"
        ],
        "allow_missing_taint": false,
        "require_message_type": "artifact"
      },
      "artifact_policy": {
        "allowed_operations": [
          "submit"
        ],
        "max_artifact_bytes": 65536,
        "review_injection_as_warning": true
      },
      "output_policy": {
        "block_secrets": true,
        "block_private_urls": true,
        "block_internal_paths": true
      }
    },
    "fc.llm.chat": {
      "kind": "openai_chat_completions",
      "allowed_callers": [
        "fc_worker"
      ],
      "required_capability": "worker_llm",
      "require_run_id": true,
      "description": "Worker -> same model as the parent agent. ASG injects the backend credential; the worker holds none.",
      "backend": {
        "mode": "http",
        "base_url": "http://llm-backend.example:9200/v1",
        "path": "/chat/completions",
        "model_rewrite": "main",
        "api_key_env": "ASG_WORKER_LLM_API_KEY",
        "max_tokens": 32768,
        "timeout_seconds": 1000,
        "drop_response_message_fields": [
          "reasoning_content"
        ]
      },
      "input_policy": {
        "accepted_taint": [
          "untrusted_web",
          "sandbox_output",
          "model_output"
        ],
        "allow_missing_taint": false,
        "max_messages": 12,
        "block_on_review": false,
        "allowed_private_instruction_hosts": [
          "localhost",
          "127.0.0.1"
        ],
        "allow_scanner_findings": [
          "input_dlp:private_host",
          "input_dlp:high_entropy_path",
          "input_dlp:encoded_path",
          "input_dlp:url_query",
          "input_dlp:url_fragment",
          "input_dlp:punycode_host",
          "input_dlp:url_shortener",
          "input_dlp:local_path"
        ]
      },
      "output_policy": {
        "block_secrets": true,
        "block_private_urls": true,
        "block_internal_paths": true,
        "allow_fetch_query_to_run_hosts": true
      },
      "action_policy": {
        "read_only_model": true
      },
      "report_run_warnings": true
    },
    "fc.search": {
      "kind": "http_json",
      "description": "researcher profile only: web search via the research service (filtered results). Callable only if spawn_worker registered the route for that run.",
      "allowed_callers": [
        "fc_worker"
      ],
      "required_capability": "worker_search",
      "require_run_id": true,
      "backend": {
        "mode": "http",
        "base_url": "http://<RESEARCH_SERVICE_HOST>:8790",
        "path": "/search",
        "method": "POST",
        "timeout_seconds": 60,
        "require_signature": true,
        "passthrough_error_codes": ["url_not_eligible", "url_scheme", "url_userinfo", "url_port", "url_ip_literal", "url_host", "url_blocked_host", "url_blocked_url", "url_malformed", "non_public_address", "dns_failed", "fetch_failed", "too_many_redirects", "redirect_not_allowed", "content_type_not_allowed", "host_quota_exceeded", "fetch_quota_exceeded", "byte_quota_exceeded", "search_quota_exceeded", "empty_query", "search_backend_error"]
      },
      "input_policy": {
        "accepted_taint": [
          "untrusted_web",
          "model_output"
        ],
        "allow_missing_taint": false,
        "max_messages": 1
      },
      "output_policy": {
        "block_secrets": true,
        "block_private_urls": true,
        "block_internal_paths": true,
        "untrusted_tool_result": true
      },
      "report_run_warnings": true
    },
    "fc.fetch": {
      "kind": "http_json",
      "description": "researcher profile only: fetch of a URL eligible for this run (seed, search result or linked page); checked and fetched by the research service.",
      "allowed_callers": [
        "fc_worker"
      ],
      "required_capability": "worker_fetch",
      "require_run_id": true,
      "backend": {
        "mode": "http",
        "base_url": "http://<RESEARCH_SERVICE_HOST>:8790",
        "path": "/fetch",
        "method": "POST",
        "timeout_seconds": 60,
        "require_signature": true,
        "passthrough_error_codes": ["url_not_eligible", "url_scheme", "url_userinfo", "url_port", "url_ip_literal", "url_host", "url_blocked_host", "url_blocked_url", "url_malformed", "non_public_address", "dns_failed", "fetch_failed", "too_many_redirects", "redirect_not_allowed", "content_type_not_allowed", "host_quota_exceeded", "fetch_quota_exceeded", "byte_quota_exceeded", "search_quota_exceeded", "empty_query", "search_backend_error"]
      },
      "input_policy": {
        "accepted_taint": [
          "untrusted_web",
          "model_output"
        ],
        "allow_missing_taint": false,
        "max_messages": 1
      },
      "output_policy": {
        "block_secrets": true,
        "block_private_urls": true,
        "block_internal_paths": true,
        "untrusted_tool_result": true
      },
      "report_run_warnings": true
    },
    "fc.repo": {
      "kind": "http_json",
      "description": "repo_auditor profile only: read-only tree/read/grep over a repository snapshot the orchestrator registered for this run; served by the research service (the worker never names a URL).",
      "allowed_callers": [
        "fc_worker"
      ],
      "required_capability": "worker_repo",
      "require_run_id": true,
      "backend": {
        "mode": "http",
        "base_url": "http://<RESEARCH_SERVICE_HOST>:8790",
        "path": "/repo",
        "method": "POST",
        "timeout_seconds": 90,
        "require_signature": true,
        "passthrough_error_codes": ["repo_not_registered", "repo_not_found", "repo_quota_exceeded", "bad_op", "bad_path", "bad_pattern", "bad_start_line", "path_not_found", "not_a_directory", "not_text_file", "file_too_large", "non_public_address", "dns_failed", "archive_fetch_failed", "archive_too_large", "archive_too_many_files", "archive_unsafe_path", "archive_invalid", "archive_empty"]
      },
      "input_policy": {
        "accepted_taint": [
          "untrusted_github",
          "model_output"
        ],
        "allow_missing_taint": false,
        "max_messages": 1
      },
      "output_policy": {
        "block_secrets": true,
        "block_private_urls": true,
        "block_internal_paths": true,
        "untrusted_tool_result": true
      },
      "report_run_warnings": true
    },
    "security.decoy.export": {
      "kind": "canary",
      "allowed_callers": [
        "*"
      ],
      "required_capability": "inspect",
      "description": "Decoy route: any call revokes the calling agent (requires the canary section)."
    }
  },
  "canary": {
    "enabled": true,
    "hmac_key_env": "ASG_CANARY_HMAC_KEY",
    "registry_file": "~/.agent-security-gateway/canaries.jsonl",
    "on_trip": {
      "revoke_agent": true,
      "kill_switch": false
    }
  },
  "llm_snippet_check": {
    "enabled": true,
    "timeout_seconds": 50,
    "_note": "endpoint/model default to llm_inspector; may only lower downgradable pattern findings",
    "apply_to_output": true
  },
  "test_modes": {
    "input_guard_log_only": {
      "enabled": false,
      "routes": [
        "fc.llm.chat"
      ],
      "allowed_registrars": [
        "parent_mcp"
      ],
      "max_ttl_seconds": 3600
    }
  },
  "quarantined_read": {
    "enabled": false,
    "routes": [
      "fc.llm.chat"
    ],
    "allowed_registrars": [
      "parent_mcp"
    ],
    "max_risk_score": 40,
    "_note": "opt-in per run (read_mode=quarantined, operator-only); injection-type input findings only - the action guard keeps blocking private/metadata/dangerous targets and caller-controlled backends; see runbook"
  },
  "run_model_quota": {
    "enabled": true,
    "max_model_calls_per_run": 200,
    "_note": "hard gateway-side per-run cap on model invocations (chat-completions routes with a run_id); restart resets the counter"
  }
}
