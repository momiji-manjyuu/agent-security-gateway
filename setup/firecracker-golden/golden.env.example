# ASG Firecracker golden image 設定例。コピーして編集: cp golden.env.example golden.env
# すべて任意。未設定時はスクリプト内のデフォルト値が使われます。秘密情報は絶対に書かないこと。
ASG_ROOT=/srv/asg                 # ASG ルート (golden/, bin/, logs/ が配下)
ASG_GROUP=asg                     # 成果物を読めるグループ
ASG_ORCH_USER=asg-orch            # firecracker を実行する非特権ユーザー (kvm グループ所属)
ASG_LOG_OWNER=                    # ログのコピー先所有者 (空ならコピーしない)
ASG_LOG_COPY_DIR=                 # ログのコピー先ディレクトリ
# --- rootfs ---
UBUNTU_SUITE=noble
UBUNTU_SNAPSHOT=20261022T000000Z  # snapshot.ubuntu.com の固定日付 (再現性)
UBUNTU_MIRROR=                    # 明示指定時は snapshot より優先 (例 https://archive.ubuntu.com/ubuntu ※非再現)
SOURCE_DATE_EPOCH=1792540800
GUEST_USER=worker
GUEST_UID=1000
GUEST_HOSTNAME=asg-worker
GUEST_DNS="1.1.1.1 9.9.9.9"
GUEST_OVERLAY_TMPFS_SIZE=2G
VNC_DISPLAY=1                     # ポート = 5900 + VNC_DISPLAY
VNC_GEOMETRY=1600x900
# --- kernel ---
KERNEL_VERSION=6.18.58
KERNEL_OUT_DIR=                   # build-golden の参照先。既定: $ASG_ROOT/kernel/$KERNEL_VERSION (vmlinux と .config を配置)
HARNESS_DIR=                      # イメージに含める harness (指定時は gitleaks 必須)
# --- boot test / worker sizing ---
FC_BIN=/srv/asg/bin/firecracker
BRIDGE=asgbr0
BRIDGE_IP=10.90.0.1
GUEST_IP=10.90.0.2
NETMASK=255.255.255.0
TAP_DEV=asgtap-t
GUEST_MAC=06:00:0a:5a:00:02
VCPU_COUNT=2
MEM_MIB=6144
BOOT_TIMEOUT_S=180
# --- host network isolation (host-network.sh) — 例示用アドレス (RFC 5737)。必ず自環境に合わせて変更 ---
WAN_IF=eth0                       # ホストの上流 NIC
WORKER_CIDR=10.90.0.0/24          # BRIDGE_IP を含むワーカーサブネット
LAN_CIDR=192.0.2.0/24             # ホストが属する LAN
LAN_BCAST=192.0.2.255
LAN_GW=192.0.2.1                  # ホスト用 DNS/DHCP/ゲートウェイ
ASG_IP=192.0.2.80                 # ASG ハブ (ワーカーから唯一到達可能な LAN 宛先)
ASG_PORT=8788
# --- host base setup (host-setup.sh) ---
HOST_DNS=                         # 例 192.0.2.1。空なら DNS 固定しない
DISABLE_IPV6=1
DISABLE_CUPS_AVAHI=1
SSHD_ALLOW_USERS=                 # 例 "admin@192.0.2.70"。空なら sshd は変更しない (締め出し防止)
# --- manifest signing ---
SIGN_METHOD=ssh                   # ssh (ssh-keygen -Y) | minisign
SIGN_KEY=                         # 署名鍵のパス (署名ホスト上。ワーカーホストに置かない)
SIGN_NAMESPACE=asg-golden         # ssh-keygen -Y の namespace
SIGN_IDENTITY=asg-golden          # allowed_signers の principal
VERIFY_PUBKEY=/etc/asg/golden-signers   # ssh: allowed_signers ファイル / minisign: 公開鍵
ASG_REQUIRE_SIGNED=0              # 1 で未署名・不正署名の MANIFEST を拒否
