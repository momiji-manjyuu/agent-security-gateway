# /etc/asg/fc-worker.env — root-owned (0644 root:root). Parsed (never sourced) by /usr/local/sbin/asg-fc-worker:
# plain KEY=VALUE lines only, known ASG_FC_* keys, no expansion or shell syntax; anything else fails closed.
# Defaults shown; change only what differs on your worker host.
ASG_FC_GOLDEN=/srv/asg/golden/current
ASG_FC_BIN=/srv/asg/bin/firecracker
ASG_FC_USER=asg-orch
ASG_FC_GROUP=asg
ASG_FC_BRIDGE=asgbr0
ASG_FC_TAP=asgtap-w
ASG_FC_HOST_IP=10.90.0.1          # bridge address; ASG is reachable here (reverse tunnel), nothing else
ASG_FC_GUEST_IP=10.90.0.2
ASG_FC_ASG_PORT=8788
ASG_FC_RUN_ROOT=/run/asg          # tmpfs
ASG_FC_LOG_DIR=/srv/asg/logs
ASG_FC_KVM_PERMS=/usr/local/sbin/asg-kvm-perms
ASG_FC_AGENT=/usr/local/lib/asg/worker_agent.py
ASG_FC_MEM_MIB=2048
ASG_FC_VCPUS=2
ASG_FC_TIMEOUT=300
# researcher profile (optional): VM wall-clock cap and the research service used to register each run.
ASG_FC_TIMEOUT_MAX=3000
# ASG_FC_RESEARCH_URL=http://192.168.1.90:8790          # research_service.py (LAN address only the hub and this host reach)
# ASG_FC_RESEARCH_KEY_FILE=/etc/asg/research-register.key # root-only file, >= 32 characters; same value as the service's ASG_RESEARCH_REGISTER_KEY
